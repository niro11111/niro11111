# Claude Code Academy server. Copy to .env and adjust. Every value has a safe default.

# development | production | test
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# SQLite file (keep it on a persistent volume)
DATABASE_PATH=/data/academy.db
# folder with the built web app (./build.sh creates site/)
SITE_DIR=/app/site

# the public address, e.g. https://academy.example.com (also accepted as a request Origin)
PUBLIC_URL=

# login session length in days
SESSION_DAYS=30
# Secure cookies (default: on in production). Turn off only for plain http on localhost.
COOKIE_SECURE=true
# true when behind a reverse proxy or a platform load balancer (Fly, Render, Nginx), so client IPs are right
TRUST_PROXY=false

# comma-separated emails that may read /api/admin/stats
ADMIN_EMAILS=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# automatic online backups of the database
BACKUP_DIR=/data/backups
BACKUP_EVERY_HOURS=24

# ---------- AI gateway (optional) ----------
# With a key and a model, signed-in users get the tutor and every AI feature on this server.
# The key never reaches the browser. Leave empty to keep AI off.
ANTHROPIC_API_KEY=
# a current model id from the Anthropic models page (docs.anthropic.com -> Models)
AI_MODEL=
# low | medium | high | xhigh | max (empty = the model's default)
AI_EFFORT=
# hard cap on output tokens per request, and requests per user per day (0 = unlimited)
AI_MAX_TOKENS=8000
AI_DAILY_REQUESTS=100
# server-side refusal fallback: auto (on for models that support it) | on | off
AI_FALLBACKS=auto

# ---------- Automation: Make / Zapier / n8n (optional) ----------
# events (user.registered, progress.milestone, certificate.issued, user.deleted) are POSTed here,
# signed in x-cca-signature: sha256=HMAC(WEBHOOK_SECRET, x-cca-timestamp + "." + body)
WEBHOOK_URL=
WEBHOOK_SECRET=
# true = include the user's email in events (only if your privacy policy allows it)
WEBHOOK_INCLUDE_PII=false
# Bearer token for the read-only integration API (/api/integrations/stats, /api/integrations/certificates)
INTEGRATION_TOKEN=
